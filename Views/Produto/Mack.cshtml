@model List<Katchau_Back.Models.Produto>

@{
    Layout = null;
    var usuarioLogado = Context.Session.GetInt32("UsuarioId") != null;
    var nomeUsuario = Context.Session.GetString("UsuarioNome");
    var isAdmin = Context.Session.GetString("UsuarioAdmin") == "true";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Caminhao</title>
    <link rel="stylesheet" href="~/css/mack.css"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    <header>
        <a href="/Home/Index">
            <img src="~/icon/Logo-raiozinho.png" alt="Logo raio" class="Logo-raiozinho">
        </a>

        <nav class="navegacao">
            <div class="container-navegacao">
                <a href="/Produto/ListarProdutos?categoria=Pneus" class="texto-nav">Pneus</a>
                <a href="/Produto/ListarProdutos?categoria=Pecas%20Usadas" class="texto-nav">Peças Diversas</a>
                <a href="/Produto/ListarProdutos?categoria=Esportivas" class="texto-nav">Esportivos</a>
                <a href="/Produto/ListarProdutos?categoria=Customizacao" class="texto-nav">Customização</a>
            </div>
        </nav>

        @if (!usuarioLogado)
        {
            <a href="/Login/Index" class="botao-login">Entrar</a>
        }
        else
        {
            if(isAdmin)
            {
                <a href="@Url.Action("AdicionarProduto", "Produto")" class="botao-login">Adicionar Produto</a>
            }
            else
            {
                <a href="@Url.Action("Carrinho", "Usuario", new { id = Context.Session.GetInt32("UsuarioId") })" class="texto-nav">Olá, @nomeUsuario 👋</a>
            }
        }
    </header>

    <div class="banner-mack">
        <div class="container-banner">
            <img src="~/icon/katchau-com-logo.png" alt="">
            <img src="~/Imgs/mack.png" alt="" class="mack-banner">
        </div>
    </div>

    <main class="area-produto">
        <section class="lista-produtos">
            <ul class="produtos">
                @foreach (var p in Model)
                {
                    <li class="produto">
                        <img src="~/@p.foto" alt="@p.Descricao" class="imagem-produto" />
                        <div class="informacoes-produto">
                            <p>@p.Descricao</p>
                            <button class="botao-carrinho">
                                <img src="~/icon/icone-carrinho.svg" class="icone-carrinho">
                                Adicionar ao carrinho
                            </button>
                        </div>
                    </li>
                }
            </ul>
        </section>
    </main>

    <footer>
        <div class="footer">
            <img src="~/icon/Logo-completo-marrom.png" class="logo-footer">
            <div class="explore">
                <li>Home</li>
                <li>Pecas Esportivas</li>
                <li>Pecas Diversas</li>
                <li>Customizacao</li>
            </div>
            <div class="suporte">
                <li>Obtenha Ajuda</li>
                <li>Registro e Garantia</li>
                <li>Fale Conosco</li>
            </div>
            <div class="redes">
                <h1 class="rede">Redes</h1>
                <img src="~/icon/mdi--youtube (1).svg">
                <img src="~/icon/mdi--instagram (1).svg">
                <img src="~/icon/ic--baseline-tiktok (1).svg">
                <img src="~/icon/ic--baseline-whatsapp (1).svg">
                <img src="~/icon/ic--baseline-facebook (1).svg">
            </div>
        </div>
        <p class="copyright">
            Copyright © 2025 Katchau Inc. All rights reserved.
        </p>
    </footer>
</body>
</html>