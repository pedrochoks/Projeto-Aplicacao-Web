@model List<Katchau_Back.Models.Produto>

@{
    Layout = null;
    var usuarioLogado = Context.Session.GetInt32("UsuarioId") != null;
    var nomeUsuario = Context.Session.GetString("UsuarioNome");
    var isAdmin = Context.Session.GetString("UsuarioAdmin") == "true";
}

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Peças Usadas</title>
    <link rel="stylesheet" href="~/css/mate.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
</head>

<body>
    <header class="cabecalho">
        <div class="container-cabecalho">
            <a href="/Home/Index">
                <img class="logo-raio" src="~/icon/Logo-raiozinho.png" alt="logo-raio">
            </a>
            <nav class="menu">
                <a href="/Produto/ListarProdutos?categoria=Pneus" class="texto-nav">Pneus</a>
                <a href="/Produto/ListarProdutos?categoria=Pecas%20para%20caminhao" class="texto-nav">Caminhões</a>
                <a href="/Produto/ListarProdutos?categoria=Esportivas" class="texto-nav">Esportivos</a>
                <a href="/Produto/ListarProdutos?categoria=Pecas%20usadas" class="texto-nav">Peças Usadas</a>
                <a href="/Produto/ListarProdutos?categoria=Customizacao" class="texto-nav">Customização</a>
            </nav>

            @if (!usuarioLogado)
            {
                <a href="/Login/Index" class="botao-entrar">Entrar</a>
            }
            else
            {
                if (isAdmin)
                {
                    <a href="@Url.Action("Index", "CadastrarProduto")" class="botao-entrar">Cadastrar Produto</a>
                }
                else
                {
                    <span class="texto-nav">Olá, @nomeUsuario 👋</span>
                }
            }

            <div class="tres-barrinhas">
                <img src="~/icon/tres-barrinhas.png" alt="menu">
            </div>
        </div>
    </header>

    <div class="banner">
        <div class="img-katchau">
            <img src="~/icon/katchau-com-logo.png" alt="">
        </div>
        <img class="mate-banner" src="~/Imgs/mate.png" alt="">
    </div>

    <main class="conteudo">
        <section class="lista-produtos">
            <ul class="produtos">
                @if (Model != null && Model.Any())
                {
                    foreach (var p in Model)
                    {
                        <li class="produto">
                            @if (p.foto != null)
                            {
                                <img class="imagem-produto" src="data:image/jpeg;base64,@Convert.ToBase64String(p.foto)"
                                     alt="@p.Nome"
                                     style="width: 100%; max-width: 380px; height: 260px; object-fit: cover; border-radius: 10px;" />
                            }
                            <div class="informacoes-produto">
                                <h3>@p.Nome</h3>
                                <p>@p.Descricao</p>
                                <span class="preco">R$ @string.Format("{0:F2}", p.Preco ?? 0)</span>
                                <form asp-controller="Carrinho" asp-action="Adicionar" method="post">
                                    <input type="hidden" name="id" value="@p.id_produto" />
                                    <button class="botao-carrinho">
                                        <img src="~/icon/icone-carrinho.svg" class="icone-carrinho">
                                        Adicionar ao carrinho
                                    </button>
                                </form>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <p>Nenhum produto encontrado na categoria Peças Usadas.</p>
                }
            </ul>
        </section>
    </main>

    <footer>
        <div class="rodape">
            <img src="~/Imgs/Logo-katchau.png" class="logo-footer">
            <div class="explore">
                <h1>Explore</h1>
                <ul>
                    <li>Home</li>
                    <li>Peças Esportivas</li>
                    <li>Peças Diversas</li>
                    <li>Customização</li>
                </ul>
            </div>
            <div class="suporte">
                <h1>Suporte</h1>
                <ul>
                    <li>Obtenha Ajuda</li>
                    <li>Registro e Garantia</li>
                    <li>Fale Conosco</li>
                </ul>
            </div>
            <div class="redes">
                <h1>Redes</h1>
                <img src="~/icon/icone-youtube2.png">
                <img src="~/icon/icone-instagram.png">
                <img src="~/icon/ic--baseline-tiktok (1).svg">
                <img src="~/icon/icone-whatsapp.png">
                <img src="~/icon/icone-facebook.png">
            </div>
        </div>
        <span class="linha-footer"></span>
        <p class="copyright">
            Copyright © 2025 Katchau Inc. All rights reserved.
        </p>
    </footer>
</body>

</html>
