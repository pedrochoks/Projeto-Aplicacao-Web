@model List<Katchau_Back.Models.Produto>

@{
    Layout = null;
    var usuarioLogado = Context.Session.GetString("Id_usuario") != null;
}

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projeto Katchau</title>

    <link rel="stylesheet" href="~/css/mcqueen.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
</head>

<body>
    <header class="cabecalho">
        <div class="container-cabecalho">
            <a href="/Home/Index"><img class="logo-raio" src="~/icon/Logo-raiozinho.png" alt="logo-raio"></a>
            <nav class="menu">
                <a href="/Produto/ListarProdutos?categoria=Pneus" class="texto-nav">Pneus</a>
                <a href="/Produto/ListarProdutos?categoria=Pecas%20para%20caminhao" class="texto-nav">Caminhões</a>
                <a href="/Produto/ListarProdutos?categoria=Esportivos" class="texto-nav">Esportivos</a>
                <a href="/Produto/ListarProdutos?categoria=Pecas%20usadas" class="texto-nav">Peças Diversas</a>
                <a href="/Produto/ListarProdutos?categoria=Customizacao" class="texto-nav">Customizacao</a>
            </nav>
            </nav>

            @if (!usuarioLogado)
            {
                <button class="botao-entrar">Entrar</button>
            }

            <div class="tres-barrinhas">
                <img src="~/img-luigi/tres-barrinhas.png" alt="menu">
            </div>
        </div>
    </header>

    <div class="banner">
        <div class="img-katchau">
            <img src="~/icon/katchau-com-logo.png" alt="">
        </div>
        <img class="luigi-banner" src="~/Imgs/McQueen.png" alt="">
    </div>

    <main class="conteudo">

        <section class="lista-produtos" id="lista-produtos">
            <ul class="produtos">
                @foreach (var p in Model)
                {
                    <li class="produto">
                        <img src="@p.foto" alt="Imagem Produto" class="imagem-produto" />

                        <div class="informacoes-produto">
                            <p>@p.Descricao</p>

                            <button class="botao-carrinho">
                                <img src="~/img-luigi/icone-carrinho.svg" alt="carrinho" class="icone-carrinho">
                                Adicionar ao carrinho
                            </button>
                        </div>
                    </li>
                }
            </ul>
        </section>

        <aside class="filtros">
            <form asp-controller="Produto" asp-action="ListarProdutos" method="get">
                <input type="hidden" name="categoria" value="Pecas usadas" />

                <div class="filtro-preco">
                    <h3>Preço</h3>

                    <h1>Maior que</h1>
                    <input type="number" id="min-preco" name="PrecoMin" placeholder="R$ 0">

                    <h1>Menor que</h1>
                    <input type="number" id="max-preco" name="PrecoMax" placeholder="R$ 10000">
                </div>

                <div class="filtro-grupo">
                    <div class="filtro-departamentos" id="opcoes-departamentos">
                        <h3>Departamentos</h3>
                        <label><input type="checkbox" value="Volantes">Volantes</label><br>
                        <label><input type="checkbox" value="Macaco">Macaco</label><br>
                        <label><input type="checkbox" value="Multimidia">Multimidia</label><br>
                        <label><input type="checkbox" value="Bancos">Bancos</label><br>
                        <label><input type="checkbox" value="Lataria">Lataria</label><br>
                    </div>
                </div>
                <button type="submit" id="filtrar" class="botao-filtro">Aplicar Filtros</button>
            </form>
        </aside>

    </main>

    <footer>
        <div class="rodape">
            <img src="~/icon/Logo-completo-marrom.png" alt="" class="logo-footer">

            <div class="explore">
                <h1>Explore</h1>
                <li>Home</li>
                <li>Peças Esportivas</li>
                <li>Peças Diversas</li>
                <li>Customização</li>
            </div>

            <div class="suporte">
                <h1>Suporte</h1>
                <li>Obtenha Ajuda</li>
                <li>Registro e Garantia</li>
                <li>Fale Conosco</li>
            </div>

            <div class="redes">
                <h1 class="rede">Redes</h1>
                <img src="~/icon/icone-youtube.png" alt="">
                <img src="~/icon/icone-instagram.png" alt="">
                <img src="~/icon/icone-tiktok.png" alt="">
                <img src="~/icon/icone-whatsapp.png" alt="">
                <img src="~/icon/icone-facebook.png" alt="">
            </div>
        </div>

        <span class="linha-footer"></span>
        <p class="copyright">
            Copyright © 2025 Katchau Inc. All rights reserved.
        </p>
    </footer>

</body>

</html>
