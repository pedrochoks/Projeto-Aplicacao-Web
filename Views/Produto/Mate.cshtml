@model List<Katchau_Back.Models.Produto>

@{
    Layout = null;
    var usuarioLogado = Context.Session.GetInt32("UsuarioId") != null;
}

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pecas Usadas</title>

    <link rel="stylesheet" href="~/css/mate.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
</head>

<body>
    <header class="cabecalho">
        <div class="container-cabecalho">
            <a href="/Home/Index">
                <img class="logo-raio" src="~/icon/Logo-raiozinho.png" alt="logo-raio">
            </a>

            <nav class="menu">
                <a class="texto-nav">Pneus</a>
                <a class="texto-nav">Caminhões</a>
                <a class="texto-nav">Esportivos</a>
                <a href="/Produto/ListarProdutos?categoria=Pecas%20usadas" class="texto-nav">Peças Usadas</a>
                <a class="texto-nav">Customizacao</a>
            </nav>

            @if (!usuarioLogado)
            {
                <a href="/Login/Index">
                    <button class="botao-entrar">Entrar</button>
                </a>
            }

            <div class="tres-barrinhas">
                <img src="~/icon/tres-barrinhas.png" alt="menu">
            </div>
        </div>
    </header>

    <div class="banner">
        <div class="img-katchau">
            <img src="~/icon/katchau-com-logo.png" alt="">
        </div>
        <img class="mate-banner" src="~/Imgs/mate.png" alt="">
    </div>

    <main class="conteudo">
        <section class="lista-produtos">
            <ul class="produtos">
                @if (Model != null && Model.Any())
                {
                    foreach (var p in Model)
                    {
                        <li class="produto">
                            <img src="~/@p.foto" alt="@p.Descricao" class="imagem-produto">
                            <div class="informacoes-produto">
                                <p>@p.Descricao</p>
                                <button class="botao-carrinho">
                                    <img src="~/icon/icone-carrinho.svg" class="icone-carrinho">
                                    Adicionar ao carrinho
                                </button>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <p>Nenhum produto encontrado na categoria Peças Usadas.</p>
                }
            </ul>
        </section>

        <aside class="filtros">
            <form asp-controller="Produto" asp-action="ListarProdutos" method="get">
                <input type="hidden" name="categoria" value="Pecas usadas" />

                <div class="filtro-preco">
                    <h3>Preço</h3>

                    <h1>Maior que</h1>
                    <input type="number" name="PrecoMin" placeholder="R$ 0">

                    <h1>Menor que</h1>
                    <input type="number" name="PrecoMax" placeholder="R$ 10000">
                </div>

                <div class="filtro-departamentos">
                    <h3>Departamentos</h3>
                    <label><input type="checkbox"> Volantes</label><br>
                    <label><input type="checkbox"> Macaco</label><br>
                    <label><input type="checkbox"> Multimídia</label><br>
                    <label><input type="checkbox"> Bancos</label><br>
                    <label><input type="checkbox"> Lataria</label><br>
                </div>

                <button type="submit" class="botao-filtro">Aplicar Filtros</button>
            </form>
        </aside>
    </main>

    <footer>
        <div class="rodape">
            <img src="~/icon/katchau-rodape.png" class="logo-footer">

            <div class="explore">
                <h1>Explore</h1>
                <li>Home</li>
                <li>Peças Esportivas</li>
                <li>Peças Diversas</li>
                <li>Customização</li>
            </div>

            <div class="suporte">
                <h1>Suporte</h1>
                <li>Obtenha Ajuda</li>
                <li>Registro e Garantia</li>
                <li>Fale Conosco</li>
            </div>

            <div class="redes">
                <h1>Redes</h1>
                <img src="~/icon/icone-youtube2.png">
                <img src="~/icon/icone-instagram.png">
                <img src="~/icon/ic--baseline-tiktok (1).svg">
                <img src="~/icon/icone-whatsapp.png">
                <img src="~/icon/icone-facebook.png">
            </div>
        </div>

        <span class="linha-footer"></span>
        <p class="copyright">
            Copyright © 2025 Katchau Inc. All rights reserved.
        </p>
    </footer>
</body>
</html>
