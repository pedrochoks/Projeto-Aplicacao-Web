@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Customização</title>
    <link rel="stylesheet" href="~/css/ramon.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet" />
</head>

<body>
    <header class="cabecalho">
        <button class="tres-barrinhas" id="btn-mobile">
            <img src="~/icon/tres-barrinhas.png" class="icone-tres-barrinhas" />
        </button>

        <img class="logo" src="~/icon/-B3EBF2 (1) 1.png" alt="Logo Katchau" />

        <nav class="menu" id="menu">
            <a href="#">Pneus</a>
            <a href="#">Caminhões</a>
            <a href="#">Esportivos</a>
            <a href="#">Peças Diversas</a>
        </nav>

        <button class="botao-entrar">Entrar</button>
    </header>

    <section class="banner"></section>

    <main class="conteudo">

        <section class="lista-produtos">
            <h1 class="pecas-custumizacao">Peças para Customização</h1>

            <ul class="produtos">
                @foreach (var p in Model)
                {
                    <li class="produto">
                        <img src="~/@p.foto" alt="@p.Descricao" class="imagem-produto" />

                        <div class="informacoes-produto">
                            <p>@p.Descricao</p>

                            <button class="botao-carrinho">
                                <img src="~/icon/icone-carrinho.svg" alt="" class="icone-carrinho">
                                Adicionar ao carrinho
                            </button>
                        </div>
                    </li>
                }
            </ul>
        </section>

        <aside class="filtro">
            <h1 class="Filtros">Filtros</h1>

            <div class="filtro-preco">
                <h3 class="preco">Preço</h3>
                <p>Maior que <strong>ADICIONAR FILTRO</strong></p>
                <p>Menor que <strong>ADICIONAR FILTRO</strong></p>
            </div>

            <div class="filtro-categoria">
                <h3 class="categoria">Categorias</h3>
                <p>Low Rider <strong>ADICIONAR FILTRO</strong></p>
                <p>Adesivo <strong>ADICIONAR FILTRO</strong></p>
                <p>Leds Automotivos<strong>ADICIONAR FILTRO</strong></p>
                <p>Tintas<strong>ADICIONAR FILTRO</strong></p>
            </div>
        </aside>

    </main>

    <footer>
        <div class="footer">
            <div class="div-esquerda">
                <img src="~/icon/img-katchau.png" alt="" class="logo-footer" />

                <div class="explore">
                    <h1>Explore</h1>
                    <li>Home</li>
                    <li>Peças Esportivas</li>
                    <li>Peças Diversas</li>
                    <li>Customização</li>
                </div>

                <div class="suporte">
                    <h1>Suporte</h1>
                    <li>Obtenha Ajuda</li>
                    <li>Registro e Garantia</li>
                    <li>Fale Conosco</li>
                </div>
            </div>

            <div class="redes">
                <h1 class="rede">Redes</h1>
                <div class="img">
                    <img src="~/icon/icone-youtube2.png" alt="youtube" />
                    <img src="~/icon/icone-instagram.png" alt="instagram" />
                    <img src="~/icon/icone-tiktiok.png" alt="tiktok" />
                    <img src="~/icon/icone-whatsapp.png" alt="whatsapp" />
                    <img src="~/icon/icone-facebook.png" alt="facebook" />
                </div>
            </div>
        </div>

        <span class="linha-footer"></span>
        <p class="copyright">Copyright © 2025 Katchau Inc. All rights reserved.</p>
    </footer>

    <script src="~/scripts/scripts.js"></script>

</body>

</html>