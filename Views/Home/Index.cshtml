@{
    Layout = null;
    var usuarioLogado = Context.Session.GetInt32("id_usuario") != null;
}

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projeto KATCHAU</title>
    <link rel="stylesheet" href="~/css/main.css">
</head>

<body>

    <header class="cabecalho">
        <div class="esquerda">
            <a asp-controller="Home" asp-action="Index">
                <img src="~/Imgs/Icones/Logo_Raio.png" class="logo">
            </a>
        </div>

        <nav class="navegacao">
            <a asp-controller="Produto" asp-action="ListarPodutos" asp-route-categoria="Pneus">Pneus</a>

            <a asp-controller="Produto" asp-action="Caminhoes">Caminhões</a>
            <a asp-controller="Produto" asp-action="Index" asp-route-categoria = "Esportivas">Esportivas</a>
            <a asp-controller="Produto" asp-action="Produto">Customizações</a>
        </nav>

        @if (!usuarioLogado)
        {
            <button class="botao-entrar" onclick="location.href='@Url.Action("Index","Login")'">
                Entrar
            </button>
        }
    </header>

    <main class="principal">

        <img src="~/Imgs/Icones/teste.png" class="banner">

        <div class="container-personagens">

            <div class="linha-cima">
                <div class="item mcqueen-card">
                    <img src="~/Imgs/McQueen.png">
                </div>
                <div class="item mate-card">
                    <img src="~/Imgs/mate.png">
                </div>
            </div>

            <div class="linha-baixo">
                <div class="item ramone-card">
                    <img src="~/Imgs/Ramone.png">
                </div>

                <div class="item mack-card">
                    <img src="~/Imgs/mack.png">
                </div>

                <div class="item luigi-card">
                    <img src="~/Imgs/Luigi.png">
                </div>
            </div>

        </div>

    </main>

</body>