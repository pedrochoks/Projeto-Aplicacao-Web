

@{
    Layout = null;
    ViewBag.Title = "Cadastro";
    var usuarioLogado = Context.Session.GetInt32("id_usuario");
}

<!DOCTYPE html>
<html lang="Pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro</title>

    <link rel="stylesheet" href="~/css/cadastro.css" />
    <script src="~/js/cadastro.js"></script>
</head>

<body>
    <header class="cabecalho">
        <img src="~/icon/Logo-raiozinho.png" alt="">
    </header>

    <main>
        <div class="alinhar-fundo">
            <div class="fundo-cadastro">

                <img class="logo-completo" src="~/icon/Logo-completo-marrom.png" alt="">
                <p class="texto-cadastro">Cadastre-se e venha fazer parte da rota 66</p>

                
                @if (TempData["Erro"] != null)
                {
                    <div class="alert alert-danger" style="margin-bottom: 20px;">
                        @TempData["Erro"]
                    </div>
                }

                <form class="cadastro" asp-controller="Cadastro" asp-action="Cadastro" method="post">

                    <div class="divisao-inputs">

                        <section class="input-esquerda">

                            <div class="input">
                                <h3>Nome de Usuário:</h3>
                                <input type="text" name="NomeUsuario" required />
                            </div>
                            <div class="input">
                                <h3>Cep:</h3>
                                <input type="text" name="cep" id="cep" size="10" maxlength="9"
                                onblur="pesquisacep(this.value)" required />
                            </div>

                            <div class="input">
                                <h3>CPF:</h3>
                                <input type="text" name="CPFUsuario" required />
                            </div>

                            <div class="input">
                                <h3>Rua:</h3>
                                <input name="rua" type="text" id="rua" size="60" />
                            </div>

                            <div class="input">
                                <h3>Estado:</h3>
                                 <input name="estado" type="text" id="estado" size="20" />
                            </div>

                            <div class="input">
                                <h3>Senha:</h3>
                                <input type="password" name="SenhaUsuario" placeholder="********" required />
                            </div>

                        </section>

                        <aside class="input-direita">

                            <div class="input">
                                <h3>E-mail:</h3>
                                <input type="email" name="EmailUsuario" required />
                            </div>

                            <div class="input">
                                <h3>Telefone:</h3>
                                <input type="text" name="TelefoneUsuario" required />
                            </div>

                            <div class="input">
                                <h3>Bairro:</h3>
                                <input name="bairro" type="text" id="bairro" size="40" />
                            </div>

                            <div class="input">
                                <h3>Cidade:</h3>
                                <input name="cidade" type="text" id="cidade" size="40" />
                            </div>

                            <div class="input">
                                <h3>Numero da Rua:</h3>
                                <input name="numeroRua" type="text" id="numeroRua" size="8" />
                            </div>

                            <div class="input">
                                <h3>Confirme sua Senha:</h3>
                                <input type="password" name="SenhaConfirmada" required />
                            </div>

                        </aside>

                    </div>

                    <button type="submit" class="cadastrar">Cadastrar</button>
                </form>


            </div>
        </div>
    </main>

</body>

</html>
