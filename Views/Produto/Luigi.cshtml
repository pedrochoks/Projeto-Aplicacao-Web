@model List<Katchau_Back.Models.Produto>

@{
    Layout = null;
    var usuarioLogado = Context.Session.GetString("Id_usuario") != null;
}

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projeto Katchau</title>

    <link rel="stylesheet" href="~/css/luigi.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
</head>

<body>
    <header class="cabecalho">
        <div class="container-cabecalho">
            <img class="logo-raio" src="~/icon/Logo-raiozinho.png" alt="logo-raio">
            <nav class="menu">
                <a href="/Produto/ListarPodutos?categoria=Pneus" class="texto-nav">Pneus</a>
                <a href="/Produto/ListarPodutos?categoria=Pecas%20para%20caminhao" class="texto-nav">Caminhões</a>
                <a href="/Produto/ListarPodutos?categoria=Customizacao" class="texto-nav">Esportivos</a>
                <a href="/Produto/ListarPodutos?categoria=Pecas%20usadas" class="texto-nav">Peças Diversas</a>
                <a href="" class="texto-nav">Customizacao</a>
            </nav>
            @if (!usuarioLogado)
            {
                <button class="botao-entrar">Entrar</button>
            }
            <div class="tres-barrinhas">
                <img src="~/img-luigi/tres-barrinhas.png" alt="menu">
            </div>
        </div>
    </header>

    <div class="banner">
        <div class="img-katchau">
            <img src="~/icon/katchau-com-logo.png" alt="">
        </div>
        <img class="luigi-banner" src="~/Imgs/luigi-guido.png" alt="Luigi">
    </div>

    <main class="conteudo">
        <section class="lista-produtos" id="lista-produtos">
            <ul class="produtos">

                @foreach (var p in Model)
                {
                    <li class="produto">
                        <img src="@p.foto" alt="@p.Descricao" class="imagem-produto">

                        <div class="informacoes-produto">
                            <p>@p.Descricao</p>

                            <button class="botao-carrinho">
                                <img src="~/img-luigi/icone-carrinho.svg" class="icone-carrinho" />
                                Adicionar ao carrinho
                            </button>
                        </div>
                    </li>
                }
            </ul>
        </section>

        <aside class="filtros">
            <h2>Filtros</h2>

            <div class="filtro-preco">
                <h3>Preço</h3>

                <h1>Maior que</h1>
                <input type="number" id="min-preco" placeholder="R$ 0">

                <h1>Menor que</h1>
                <input type="number" id="max-preco" placeholder="R$ 10000">
            </div>

            <div class="filtro-grupo">
                <div class="filtro-departamentos" id="opcoes-departamentos">
                    <h3>Departamentos</h3>

                    <label><input type="checkbox" value="Volantes"> Volantes</label><br>
                    <label><input type="checkbox" value="Macaco"> Macaco</label><br>
                    <label><input type="checkbox" value="Multimidia"> Multimídia</label><br>
                    <label><input type="checkbox" value="Bancos"> Bancos</label><br>
                    <label><input type="checkbox" value="Lataria"> Lataria</label><br>
                </div>
            </div>

            <button id="filtrar" class="botao-filtro">Aplicar Filtros</button>
        </aside>
    </main>

    <footer>
        <div class="rodape">
            <img src="~/icon/Logo-completo-marrom.png" alt="" class="logo-footer">

            <div class="explore">
                <h1>Explore</h1>
                <li><a href="/Home/Index">Home</a></li>
                <li><a href="/Produto/ListarPodutos?categoria=Customizacao">Pecas esportivas</a></li>
                <li><a href="/Produto/ListarPodutos?categoria=Pecas%20usadas">Pecas diversas</a></li>
                <li><a href="/Produto/ListarPodutos?categoria=Customizacao">Customizacao</a></li>
            </div>

            <div class="suporte">
                <h1>Suporte</h1>
                <li>Obtenha Ajuda</li>
                <li>Registro e Garantia</li>
                <li>Fale Conosco</li>
            </div>

            <div class="redes">
                <h1 class="rede">Redes</h1>
                <img src="~/icon/mdi--youtube (1).svg" alt="youtube">
                <img src="~/icon/mdi--instagram (1).svg" alt="instagram">
                <img src="~/icon/ic--baseline-tiktok (1).svg" alt="tiktok">
                <img src="~/icon/ic--baseline-whatsapp (1).svg" alt="whatsapp">
                <img src="~/icon/ic--baseline-facebook (1).svg" alt="facebook">
            </div>
        </div>

        <span class="linha-footer"></span>
        <p class="copyright">
            Copyright © 2025 Katchau Inc. Todos os direitos reservados.
        </p>
    </footer>

</body>

</html>
