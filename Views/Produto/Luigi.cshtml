@model List<Katchau_Back.Models.Produto>

@{
    Layout = null;
    var usuarioLogado = Context.Session.GetInt32("UsuarioId") != null;
    var nomeUsuario = Context.Session.GetString("UsuarioNome");
}

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projeto Katchau</title>
    <link rel="stylesheet" href="~/css/luigi.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
</head>

<body>

    <header class="cabecalho">
        <div class="container-cabecalho">
            <a href="/Home/Index">
                <img class="logo-raio" src="~/icon/Logo-raiozinho.png" alt="logo">
            </a>

            <nav class="menu">
                <a href="/Produto/ListarProdutos?categoria=Pneus" class="texto-nav">Pneus</a>
                <a href="/Produto/ListarProdutos?categoria=Pecas%20para%20caminhao" class="texto-nav">Caminhões</a>
                <a href="/Produto/ListarProdutos?categoria=Esportivos" class="texto-nav">Esportivos</a>
                <a href="/Produto/ListarProdutos?categoria=Pecas%20usadas" class="texto-nav">Peças Diversas</a>
                <a href="/Produto/ListarProdutos?categoria=Customizacao" class="texto-nav">Customização</a>
            </nav>

            @if (!usuarioLogado)
            {
                <a href="/Login/Index">
                    <button class="botao-entrar">Entrar</button>
                </a>
            }
            else
            {
                <span class="texto-nav">Olá, @nomeUsuario 👋</span>
            }
        </div>
    </header>

    <section class="banner">
        <img src="~/icon/katchau-com-logo.png" alt="Katchau">
        <img class="luigi-banner" src="~/Imgs/luigi-guido.png" alt="Luigi">
    </section>

    <main class="conteudo">
        <section class="lista-produtos">
            @if (Model != null && Model.Any())
            {
                <ul class="produtos">
                    @foreach (var p in Model)
                    {
                        <li class="produto">
                            @if (p.foto != null)
                            {
                                <img class="imagem-produto"
                                     src="data:image/jpeg;base64,@Convert.ToBase64String(p.foto)" 
                                     alt="@p.Nome"
                                     style="width: 100%; max-width: 380px; height: 260px; object-fit: cover; border-radius: 10px;" />
                            }

                            <div class="informacoes-produto">
                                <h3>@p.Nome</h3>
                                <p class="descricao">@p.Descricao</p>
                                <span class="preco">R$ @string.Format("{0:N2}", p.Preco)</span>

                                <form asp-controller="Carrinho" asp-action="Adicionar" method="post">
                                    <input type="hidden" name="id" value="@p.id_produto" />
                                    <button class="botao-carrinho">
                                        <img src="~/icon/icone-carrinho.svg" alt="Carrinho">
                                        Adicionar ao carrinho
                                    </button>
                                </form>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="nenhum-produto">Nenhum produto encontrado.</p>
            }
        </section>
    </main>

    <footer>
        <div class="rodape">
            <img src="~/icon/Logo-completo-marrom.png" class="logo-footer">

            <div class="explore">
                <h1>Explore</h1>
                <ul>
                    <li><a href="/Home/Index">Home</a></li>
                    <li><a href="/Produto/ListarProdutos?categoria=Esportivos">Peças esportivas</a></li>
                    <li><a href="/Produto/ListarProdutos?categoria=Pecas%20usadas">Peças diversas</a></li>
                    <li><a href="/Produto/ListarProdutos?categoria=Customizacao">Customização</a></li>
                </ul>
            </div>

            <div class="suporte">
                <h1>Suporte</h1>
                <ul>
                    <li>Obtenha Ajuda</li>
                    <li>Registro e Garantia</li>
                    <li>Fale Conosco</li>
                </ul>
            </div>
        </div>

        <p class="copyright">
            © 2025 Katchau Inc. Todos os direitos reservados.
        </p>
    </footer>

</body>
</html>
