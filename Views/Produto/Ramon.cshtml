@{
    Layout = "_Layout";
    ViewData["Title"] = "Início";
}

<section class="banner"></section>

<main class="conteudo">

    <section class="produtos" id="lista-produtos">
        </section>

    <aside class="filtros">
        <h2>Filtros</h2>

        <div class="filtro-preco">
            <h3>Preço</h3>
            <h1>Maior que</h1>
            <input type="number" id="min-preco" placeholder="R$ 0">

            <h1>Menor que</h1>
            <input type="number" id="max-preco" placeholder="R$ 10000">
        </div>

        <div class="filtro-grupo">
            <div class="filtro-departamentos" id="opcoes-departamentos">
                <h3>Departamentos</h3>
                <label><input type="checkbox" value="Low Rider"> Low Rider</label><br>
                <label><input type="checkbox" value="Adesivos"> Adesivos</label><br>
                <label><input type="checkbox" value="LEDs"> LEDs</label><br>
                <label><input type="checkbox" value="Tintas"> Tintas</label>
            </div>
        </div>

        <button id="filtrar">Aplicar Filtros</button>
    </aside>

</main>