@{
    Layout = null;
    var usuarioLogado = Context.Session.GetInt32("id_usuario") != null;
}

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projeto KATCHAU</title>
    <link rel="stylesheet" href="~/css/main.css">
</head>

<body>

    <header class="cabecalho">
        <div class="esquerda">
            <a asp-controller="Home" asp-action="Index">
                <img src="~/icon/logo-raiozinho.png" class="logo">
            </a>
        </div>

        <nav class="navegacao">
            <a asp-controller="Produto" asp-action="ListarPodutos" asp-route-categoria="Pneus">Pneus</a>

            <a asp-controller="Produto" asp-action="Caminhoes">Caminhões</a>
            <a asp-controller="Produto" asp-action="Esportivas">Esportivas</a>
            <a asp-controller="Produto" asp-action="Produto">Customizações</a>
        </nav>

        @if (!usuarioLogado)
        {
            <button class="botao-entrar" onclick="location.href='@Url.Action("Index","Login")'">
                Entrar
            </button>
        }
    </header>

    <main class="principal">

        <img src="~/Imgs/Carros-all.png" class="banner">

        <div class="container-personagens">

            <div class="linha-cima">
                <div class="item mcqueen-card">
                    <img src="~/Imgs/McQueen.png">
                </div>
                <div class="item mate-card">
                    <img src="~/Imgs/mate.png">
                </div>
            </div>

            <div class="linha-baixo">
                <div class="item ramone-card">
                    <img src="~/Imgs/Ramon.png">
                </div>

                <div class="item mack-card">
                    <img src="~/Imgs/mack.png">
                </div>

                <div class="item luigi-card">
                    <img src="~/Imgs/Luigi.png">
                </div>
            </div>

        </div>

    </main>
    <footer>
    <div class="footer">
      <div class="div-esquerda">
        <img src="~/Imgs/Logo-katchau.png" alt="" class="logo-footer">
        <div class="explore">
          <h1>Explore</h1>
          <li>Home</li>
          <li>Pecas Esportivas</li>
          <li>Pecas Diversas</li>
          <li>Customizacao</li>
        </div>
        <div class="suporte">
          <h1>Suporte</h1>
          <li>Obtenha Ajuda</li>
          <li>Registro e Garantia</li>
          <li>Fale Conosco</li>
        </div>
      </div>
      <div class="redes">
        <h1 class="rede">Redes</h1>
        <div class="img">
          <img src="~/icon/icone-youtube2.png" alt="youtube">
          <img src="~/icon/icone-instagram.png" alt="instagram">
          <img src="~/icon/icone-tiktiok.png" alt="tiktok">
          <img src="~/icon/icone-whatsapp.png" alt="whatsapp">
          <img src="~/icon/icone-facebook.png" alt="facebook">
        </div>
      </div>
    </div>
    <span class="linha-footer"></span>
    <p class="copyright">Copyright © 2025 Katchau Inc. All rights reserved.</p>
  </footer>

</body>