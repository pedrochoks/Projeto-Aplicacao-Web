@{
    Layout = null;
    ViewBag.Title = "Login";
}

<!DOCTYPE html>
<html lang="Pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>

    <link rel="stylesheet" href="~/css/login.css" />
</head>

<body>
    <header>
        <img src="~/icon/Logo-raiozinho.png" alt="">
    </header>

    <main>
        <div class="alinhar-fundo">
            <div class="fundo-login">

                <div class="logo-completa">
                    <img src="~/icon/Logo-completo-marrom.png" alt="">
                </div>

                @* MENSAGEM DE ERRO *@
                @if (TempData["Erro"] != null)
                {
                    <div class="alert alert-danger" style="margin-bottom: 15px;">
                        @TempData["Erro"]
                    </div>
                }

                <form asp-controller="Login" asp-action="Login" method="post" asp-antiforgery="true">

                    <div class="input-info">

                        <div class="input-fundo">
                            <h3 class="tipo-input">E-mail:</h3>
                            <input type="email" name="EmailLogin" placeholder="email@email.com" required />
                        </div>

                        <div class="input-fundo">
                            <h3 class="tipo-input">Senha:</h3>
                            <input type="password" name="SenhaLogin" placeholder="**********" required />
                        </div>

                    </div>

                    <button type="button" class="esqueceu-senha"><u>Esqueceu sua senha?</u></button>

                    <button type="submit" class="login">Login</button>

                    <p>Ou</p>

                    <a href="~/Cadastro/Index" class="cadastro"><u>Cadastre-se</u></a>

                </form>

            </div>
        </div>
    </main>

</body>

</html>
